<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Main pages
    RewriteRule ^sponsor$ donatie.php [L]
    RewriteRule ^contact$ contact.php [L]
    RewriteRule ^islam$ deislam.php [L]
    RewriteRule ^overons$ overons.php [L]
    RewriteRule ^algemeen$ algemeen.php [L]
    RewriteRule ^privacy$ privacy.php [L]
    RewriteRule ^educatie$ educatie.php [L]
    RewriteRule ^seminar$ seminar.php [L]
    RewriteRule ^vrijwilligers$ vrijwilligers.php [L]
    RewriteRule ^iftarbekostigen$ iftarbekostigen.php [L]
    RewriteRule ^ramadancup$ ramadancup.php [L]
    RewriteRule ^Itikaf$ Itikaf.php [L]
    RewriteRule ^donatieactie$ donatieactie.php [L]
    RewriteRule ^korancompetitie$ korancompetitie.php [L]
    RewriteRule ^events$ events.php [L]
    
    # Show pages with parameters (using direct file access for now)
    # RewriteRule ^event/([0-9]+)$ event-show.php?id=$1 [L]
    # RewriteRule ^educatie-show/([0-9]+)$ educatie-show.php?id=$1 [L]
</IfModule>